# PostgreSQL
POSTGRES_USER=salesoorja
POSTGRES_PASSWORD=change-me
POSTGRES_DB=salesoorja
DATABASE_URL=postgresql+asyncpg://salesoorja:change-me@db:5432/salesoorja
DATABASE_URL_SYNC=postgresql://salesoorja:change-me@db:5432/salesoorja

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# DeepSeek primary via Hive transport
HIVE_API_KEY=YOUR_HIVE_API_KEY
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
HIVE_ACCOUNT_MODE=UNVERIFIED
HIVE_ALLOW_PAID_OVERAGE=false
HIVE_TIMEOUT=60

# Gemini fallback
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_ACCOUNT_MODE=UNVERIFIED
ORCHESTRATOR_GEMINI_MODEL=gemini-3.1-flash-lite

# LLM safety
LLM_COST_POLICY=ZERO_COST_ONLY
ALLOW_PAID_LLM=false

# Serper production research
SERPER_API_KEY=YOUR_SERPER_API_KEY
SERPER_DAILY_HARD_LIMIT=1500
SERPER_BUDGET_TIMEZONE=Asia/Kolkata
SERPER_INITIAL_QUERIES_PER_COMPANY=4
SERPER_MAX_QUERIES_PER_COMPANY=10

# Bright Data LinkedIn person intelligence
BRIGHTDATA_API_TOKEN=YOUR_BRIGHTDATA_API_TOKEN
BRIGHTDATA_LINKEDIN_PEOPLE_SEARCH_DATASET_ID=YOUR_SEARCH_ENABLED_LINKEDIN_PEOPLE_DATASET_ID
BRIGHTDATA_LINKEDIN_PROFILE_DATASET_ID=YOUR_LINKEDIN_PROFILE_SCRAPER_DATASET_ID
BRIGHTDATA_API_BASE_URL=https://api.brightdata.com
BRIGHTDATA_TIMEOUT_SECONDS=30
BRIGHTDATA_POLL_TIMEOUT_SECONDS=75
BRIGHTDATA_CACHE_TTL_SECONDS=2592000

# Facility support
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Apollo post-qualification enrichment
APOLLO_API_KEY=YOUR_APOLLO_API_KEY

# Rediff-compatible outbound SMTP
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=YOUR_FROM_EMAIL
SMTP_FROM_NAME=Oorja Technical Services
SMTP_USE_TLS=true
OUTBOUND_TEST_MODE=true
OUTBOUND_TEST_MAILBOX=YOUR_TEST_MAILBOX

# Existing Rediff_Email_System file handoff (no SMTP credentials in Salesoorja)
REDIFF_SENDER_ENABLED=false
REDIFF_TEST_MODE=true
REDIFF_SYSTEM_PATH=
REDIFF_HANDOFF_DIR=data/rediff_handoff
REDIFF_CC_ADDRESSES=Bablu@oorjatechnical.org,piyushk@oorjatechnical.com
REDIFF_DUPLICATE_WINDOW_DAYS=14
REDIFF_TEST_TRANSPORT_ENABLED=false
REDIFF_TRANSPORT_TIMEOUT_SECONDS=120
SINGLE_LIVE_CUSTOMER_TEST_ENABLED=false

# One-click autonomous operator (SMOKE=bounded, TEST=continuous/no-send)
SALESOORJA_MODE=TEST
REAL_OUTREACH_ENABLED=false
DAILY_SEND_TARGET=150
DAILY_SEND_MAX=250
MAX_SERPER_CALLS_PER_DAY=1500
SALESOORJA_START_TIME=09:00
SALESOORJA_END_TIME=18:00
SALESOORJA_CYCLE_INTERVAL_SECONDS=300
SALESOORJA_INBOX_INTERVAL_SECONDS=1800

# Reply and enquiry tracking
IMAP_HOST=YOUR_IMAP_HOST
IMAP_PORT=993
IMAP_USER=YOUR_IMAP_USER
IMAP_PASSWORD=YOUR_IMAP_PASSWORD
IMAP_USE_SSL=true

# Application
SECRET_KEY=change-me-in-production
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=/api
