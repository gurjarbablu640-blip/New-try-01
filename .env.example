# PostgreSQL
POSTGRES_USER=salesoorja
POSTGRES_PASSWORD=salesoorja
POSTGRES_DB=salesoorja

# Database
DATABASE_URL=postgresql+asyncpg://salesoorja:salesoorja@db:5432/salesoorja
DATABASE_URL_SYNC=postgresql://salesoorja:salesoorja@db:5432/salesoorja

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# AI Keys & Zero-Cost Policy (Default UNVERIFIED blocks real dispatch until explicitly configured)
LLM_COST_POLICY=ZERO_COST_ONLY
ALLOW_PAID_LLM=false

# Account Verification (Required: Set to FREE_NO_BILLING / FREE only when verified on non-billing account)
GEMINI_ACCOUNT_MODE=UNVERIFIED
GROQ_ACCOUNT_MODE=UNVERIFIED
CLOUDFLARE_ACCOUNT_MODE=UNVERIFIED
OPENROUTER_ACCOUNT_MODE=UNVERIFIED

GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Google Maps
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Google Custom Search (Decision-Maker Discovery)
GOOGLE_SEARCH_CX=YOUR_GOOGLE_SEARCH_ENGINE_ID

# Serper.dev Search API (alternative research provider)
SERPER_API_KEY=YOUR_SERPER_API_KEY

# Apollo (Lead Enrichment)
APOLLO_API_KEY=YOUR_APOLLO_API_KEY

# Security
SECRET_KEY=your-secret-key
DEBUG=true

# Frontend
VITE_API_URL=/api

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000