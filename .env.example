# ============================================================
# Salesoorja AI Sales Intelligence — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=salesoorja
POSTGRES_PASSWORD=salesoorja
POSTGRES_DB=salesoorja

# ---- Database URL (used by backend) ----
# These are auto-constructed in docker-compose from the above values.
# Only set manually if running outside Docker:
# DATABASE_URL=postgresql+asyncpg://salesoorja:salesoorja@localhost:5432/salesoorja
# DATABASE_URL_SYNC=postgresql://salesoorja:salesoorja@localhost:5432/salesoorja

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- AI / LLM API Keys ----
# Anthropic (Claude) - Required for outreach generation, next-best-action, ICP learning
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Google Gemini - Required for semantic search embeddings (text-embedding-004)
GOOGLE_API_KEY=AIzaSy-xxxxx

# Google Maps - Required for Google Reviews mining (Module 8f)
GOOGLE_MAPS_API_KEY=AIzaSy-xxxxx

# ---- Application ----
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# ---- Frontend ----
VITE_API_URL=http://localhost:8000/api

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
